PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Cookie SameSite: keep "lax" when the site and API share a domain (or in local development).
# Use "none" only if the frontend and API are on different domains (needs HTTPS).
COOKIE_SAMESITE=lax

# Optional: real password-reset emails. Leave SMTP_HOST empty in development; the reset link is printed in this terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SpendWise <no-reply@example.com>
